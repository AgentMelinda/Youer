+    void writeBatch(FlushBatch batch) throws IOException {
+        List<EncodedWrite> encoded = new ArrayList<>(batch.writes().size());
+        for (PendingWrite pending : batch.writes()) {
+            byte[] compressed = pending.data() == null ? new byte[0] : compress(pending.data(), this.getCompressionLevel(), this.getCompressionThreads());
+            encoded.add(new EncodedWrite(pending, compressed, pending.data() == null ? 0 : checksum(pending.data())));
+        }
+
+        List<WrittenEntry> written = new ArrayList<>(encoded.size());
+        synchronized (this) {
+            this.ensureOpen();
+            long batchStart = this.file.size();
+            long position = batchStart;
+            try {
+                for (EncodedWrite encodedWrite : encoded) {
+                    PendingWrite pending = encodedWrite.pending();
+                    int flags = pending.data() == null ? FLAG_TOMBSTONE : 0;
+                    Entry entry = appendRecord(
+                        this.file,
+                        position,
+                        pending.index(),
+                        flags,
+                        pending.timestamp(),
+                        pending.generation(),
+                        pending.data() == null ? 0 : pending.data().length,
+                        encodedWrite.compressed(),
+                        encodedWrite.checksum()
+                    );
+                    written.add(new WrittenEntry(pending, entry));
+                    position += entry.recordLength();
+                }
+                this.file.force(this.sync);
+                for (WrittenEntry item : written) {
+                    Entry previous = this.entries[item.pending().index()];
+                    if (previous != null) {
+                        this.liveRecordBytes -= previous.recordLength();
+                        this.staleRecordBytes += previous.recordLength();
+                    }
+                    this.entries[item.pending().index()] = item.entry();
+                    this.liveRecordBytes += item.entry().recordLength();
+                }
+            } catch (IOException | RuntimeException failure) {
+                try {
+                    this.file.truncate(batchStart);
+                } catch (IOException truncateFailure) {
+                    failure.addSuppressed(truncateFailure);
+                }
+                throw failure;
+            }
+        }
+    }
