+    void compactIfNeeded() throws IOException {
+        FileChannel source;
+        Entry[] snapshot;
+        long fileSize;
+        synchronized (this) {
+            if (this.closed || this.liveRecordBytes == 0L) {
+                return;
+            }
+            fileSize = this.file.size();
