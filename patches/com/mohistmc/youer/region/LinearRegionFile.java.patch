+    synchronized boolean completeFlush(FlushBatch batch, @Nullable IOException failure) {
+        this.completedFlushAttempts++;
+        this.lastFlushFailure = failure;
+        if (failure == null) {
+            this.persistedGeneration = Math.max(this.persistedGeneration, batch.generation());
+            for (PendingWrite written : batch.writes()) {
+                if (this.pendingWrites[written.index()] == written) {
+                    this.pendingWrites[written.index()] = null;
+                    if (written.data() != null) {
+                        this.pendingBytes -= written.data().length;
+                    }
+                }
+            }
+        }
+        this.notifyAll();
+        return this.persistedGeneration < this.currentGeneration;
+    }
