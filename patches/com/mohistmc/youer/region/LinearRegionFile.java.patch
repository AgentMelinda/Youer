+    private void queueWrite(int index, @Nullable byte[] data, int timestamp) {
+        PendingWrite previous = this.pendingWrites[index];
+        if (previous != null && previous.data() != null) {
+            this.pendingBytes -= previous.data().length;
+        }
+        PendingWrite pending = new PendingWrite(index, data, timestamp, ++this.currentGeneration);
+        this.pendingWrites[index] = pending;
+        if (data != null) {
+            this.pendingBytes += data.length;
+        }
+        LinearRegionFileFlusher.scheduleFlush(this);
+    }
