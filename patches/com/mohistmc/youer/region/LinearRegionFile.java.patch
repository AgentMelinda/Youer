+    public int mergeFromAnvil(Path anvilPath, int regionX, int regionZ) throws IOException {
+        if (!Files.isRegularFile(anvilPath)) {
+            return 0;
+        }
+        int[] anvilTimestamps = readAnvilTimestamps(anvilPath);
+        long anvilModified = Files.getLastModifiedTime(anvilPath).toMillis();
+        long linearModified = Files.getLastModifiedTime(this.path).toMillis();
+        int selected = 0;
+
+        try (RegionFile anvil = new RegionFile(this.info, anvilPath, this.folder, false)) {
+            for (int slot = 0; slot < ENTRY_COUNT; slot++) {
+                int chunkX = (regionX << 5) + (slot & 31);
+                int chunkZ = (regionZ << 5) + (slot >>> 5);
+                ChunkPos pos = new ChunkPos(chunkX, chunkZ);
+                if (!anvil.doesChunkExist(pos)) {
+                    continue;
+                }
+                int linearTimestamp;
+                boolean linearPresent;
+                synchronized (this) {
+                    Entry entry = this.entries[slot];
+                    linearPresent = entry != null && !entry.tombstone();
+                    linearTimestamp = entry == null ? 0 : entry.timestamp();
+                    if (linearPresent) {
+                        try {
+                            this.readEntry(entry);
+                        } catch (IOException ioexception) {
+                            LOGGER.error("Linear chunk slot {} in {} failed validation; preferring a valid Anvil copy if available", slot, this.path, ioexception);
+                            linearPresent = false;
+                        }
+                    }
+                }
+                int anvilTimestamp = anvilTimestamps[slot];
+                boolean chooseAnvil = !linearPresent || anvilTimestamp > linearTimestamp || (anvilTimestamp == linearTimestamp && anvilModified > linearModified);
+                if (!chooseAnvil) {
+                    continue;
+                }
+                try (DataInputStream input = anvil.getChunkDataInputStream(pos)) {
+                    if (input == null) {
+                        continue;
+                    }
+                    byte[] data = input.readAllBytes();
+                    synchronized (this) {
+                        this.queueWrite(slot, data, anvilTimestamp == 0 ? getTimestamp() : anvilTimestamp);
+                    }
+                    selected++;
+                }
+            }
+        }
+
+        if (selected > 0) {
+            this.flush();
+        }
+        Path backup = backupPath(anvilPath, "merged");
+        Files.move(anvilPath, backup, StandardCopyOption.REPLACE_EXISTING);
+        LOGGER.warn("Merged duplicate region {} into {}; selected {} Anvil chunk(s). Original Anvil file archived as {}", anvilPath.getFileName(), this.path.getFileName(), selected, backup.getFileName());
+        return selected;
+    }
+
+    private static int[] readAnvilTimestamps(Path anvilPath) throws IOException {
+        ByteBuffer buffer = ByteBuffer.allocate(4096);
+        try (FileChannel channel = FileChannel.open(anvilPath, StandardOpenOption.READ)) {
+            readFully(channel, buffer, 4096L);
+        }
+        buffer.flip();
+        IntBuffer timestamps = buffer.asIntBuffer();
+        int[] result = new int[ENTRY_COUNT];
+        for (int index = 0; index < Math.min(timestamps.remaining(), ENTRY_COUNT); index++) {
+            result[index] = timestamps.get(index);
+        }
+        return result;
+    }
