+    private byte[] readEntry(Entry entry) throws IOException {
+        ByteBuffer compressed = ByteBuffer.allocate(entry.compressedLength());
+        if (!readFully(this.file, compressed, entry.payloadOffset())) {
+            throw new IOException("Truncated Linear chunk record in " + this.path);
+        }
+        byte[] raw;
+        try (ZstdInputStream zin = new ZstdInputStream(new ByteArrayInputStream(compressed.array()));
+             ByteArrayOutputStream out = new ByteArrayOutputStream(Math.max(32, entry.rawLength()))) {
+            zin.transferTo(out);
+            raw = out.toByteArray();
+        }
+        if (raw.length != entry.rawLength()) {
+            throw new IOException("Linear chunk decompressed length mismatch in " + this.path + ": expected " + entry.rawLength() + ", got " + raw.length);
+        }
+        if (checksum(raw) != entry.checksum()) {
+            throw new IOException("Linear chunk checksum mismatch in " + this.path);
+        }
+        return raw;
+    }
