+        if (position != fileSize) {
+            LOGGER.warn("Discarding {} incomplete trailing byte(s) from Linear region {}", fileSize - position, this.path);
+            this.file.truncate(position);
+        }
+        this.currentGeneration = maxGeneration;
+        this.persistedGeneration = maxGeneration;
+        this.recalculateRecordUsage(position);
+    }
