+        Entry[] compacted = new Entry[ENTRY_COUNT];
+        try (FileChannel target = FileChannel.open(tmp, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING)) {
+            writeFileHeader(target);
+            long position = FILE_HEADER_LENGTH;
+            for (int slot = 0; slot < snapshot.length; slot++) {
+                Entry entry = snapshot[slot];
+                if (entry == null || entry.tombstone()) {
+                    continue;
+                }
+                ByteBuffer compressed = ByteBuffer.allocate(entry.compressedLength());
+                if (!readFully(source, compressed, entry.payloadOffset())) {
+                    throw new IOException("Failed to read Linear record during compaction: " + this.path);
+                }
+                Entry newEntry = appendRecord(target, position, slot, 0, entry.timestamp(), entry.generation(), entry.rawLength(), compressed.array(), entry.checksum());
+                compacted[slot] = newEntry;
+                position += newEntry.recordLength();
+            }
+            target.force(true);
+        } catch (Throwable throwable) {
+            Files.deleteIfExists(tmp);
+            throw throwable;
+        }
+
+        synchronized (this) {
+            if (this.file != source || this.closed) {
+                Files.deleteIfExists(tmp);
+                return;
+            }
+            this.file.close();
+            try {
+                atomicReplace(tmp, this.path);
+                this.file = FileChannel.open(this.path, StandardOpenOption.READ, StandardOpenOption.WRITE);
+                System.arraycopy(compacted, 0, this.entries, 0, ENTRY_COUNT);
+                this.recalculateRecordUsage(this.file.size());
+            } catch (IOException ioexception) {
+                this.file = FileChannel.open(this.path, StandardOpenOption.READ, StandardOpenOption.WRITE);
+                throw ioexception;
+            }
+        }
+    }
