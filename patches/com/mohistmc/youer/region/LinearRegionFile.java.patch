+    private void loadV2Index() throws IOException {
+        ByteBuffer header = ByteBuffer.allocate(FILE_HEADER_LENGTH);
+        if (!readFully(this.file, header, 0L)) {
+            throw new IOException("Linear v2 header is truncated: " + this.path);
+        }
+        header.flip();
+        long signature = header.getLong();
+        int version = Byte.toUnsignedInt(header.get());
+        if (signature != SIGNATURE || version != VERSION_2) {
+            throw new IOException("Invalid Linear v2 header: " + this.path);
+        }
+
+        long fileSize = this.file.size();
+        long position = FILE_HEADER_LENGTH;
+        long maxGeneration = 0L;
+        while (position + RECORD_HEADER_LENGTH + RECORD_FOOTER_LENGTH <= fileSize) {
+            ByteBuffer recordHeader = ByteBuffer.allocate(RECORD_HEADER_LENGTH);
+            if (!readFully(this.file, recordHeader, position)) {
+                break;
+            }
+            recordHeader.flip();
+            if (recordHeader.getInt() != RECORD_MAGIC) {
+                break;
+            }
+            int slot = Short.toUnsignedInt(recordHeader.getShort());
+            int flags = Short.toUnsignedInt(recordHeader.getShort());
+            int timestamp = recordHeader.getInt();
+            long generation = recordHeader.getLong();
+            int rawLength = recordHeader.getInt();
+            int compressedLength = recordHeader.getInt();
+            int checksum = recordHeader.getInt();
+            if (slot >= ENTRY_COUNT || rawLength < 0 || compressedLength < 0 || rawLength > MAX_CHUNK_BYTES || compressedLength > MAX_CHUNK_BYTES) {
+                break;
+            }
+            long recordLength = RECORD_HEADER_LENGTH + (long) compressedLength + RECORD_FOOTER_LENGTH;
+            if (position + recordLength > fileSize) {
+                break;
+            }
+            ByteBuffer footer = ByteBuffer.allocate(RECORD_FOOTER_LENGTH);
+            if (!readFully(this.file, footer, position + RECORD_HEADER_LENGTH + compressedLength)) {
+                break;
+            }
+            footer.flip();
+            if (footer.getInt() != RECORD_COMMIT_MAGIC) {
+                break;
+            }
+            Entry existing = this.entries[slot];
+            if (existing == null || generation >= existing.generation()) {
+                this.entries[slot] = new Entry(position + RECORD_HEADER_LENGTH, rawLength, compressedLength, timestamp, generation, checksum, (flags & FLAG_TOMBSTONE) != 0, recordLength);
+            }
+            maxGeneration = Math.max(maxGeneration, generation);
+            position += recordLength;
+        }
