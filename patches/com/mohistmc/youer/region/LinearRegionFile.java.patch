+    private static Entry appendRecord(FileChannel channel, long position, int slot, int flags, int timestamp, long generation, int rawLength, byte[] compressed, int checksum) throws IOException {
+        ByteBuffer header = ByteBuffer.allocate(RECORD_HEADER_LENGTH);
+        header.putInt(RECORD_MAGIC);
+        header.putShort((short) slot);
+        header.putShort((short) flags);
+        header.putInt(timestamp);
+        header.putLong(generation);
+        header.putInt(rawLength);
+        header.putInt(compressed.length);
+        header.putInt(checksum);
+        header.flip();
+        writeFully(channel, header, position);
+        if (compressed.length > 0) {
+            writeFully(channel, ByteBuffer.wrap(compressed), position + RECORD_HEADER_LENGTH);
+        }
+        ByteBuffer footer = ByteBuffer.allocate(RECORD_FOOTER_LENGTH).putInt(RECORD_COMMIT_MAGIC);
+        footer.flip();
+        writeFully(channel, footer, position + RECORD_HEADER_LENGTH + compressed.length);
+        long recordLength = RECORD_HEADER_LENGTH + (long) compressed.length + RECORD_FOOTER_LENGTH;
+        return new Entry(position + RECORD_HEADER_LENGTH, rawLength, compressed.length, timestamp, generation, checksum, (flags & FLAG_TOMBSTONE) != 0, recordLength);
+    }
+
+    private static void writeFileHeader(FileChannel channel) throws IOException {
+        ByteBuffer header = ByteBuffer.allocate(FILE_HEADER_LENGTH);
+        header.putLong(SIGNATURE);
+        header.put((byte) VERSION_2);
+        header.put((byte) 0);
+        header.putShort((short) 0);
+        header.putLong(Util.getEpochMillis());
+        header.position(FILE_HEADER_LENGTH);
+        header.flip();
+        writeFully(channel, header, 0L);
+    }
+
+    private static byte[] compress(byte[] raw, int level, int workers) throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream(Math.max(64, raw.length / 2));
+        try (ZstdOutputStream zout = new ZstdOutputStream(output, level)) {
+            if (workers > 0) {
+                zout.setWorkers(workers);
+            }
+            zout.write(raw);
+        }
+        return output.toByteArray();
+    }
+
+    private static int checksum(byte[] data) {
+        CRC32 crc = new CRC32();
+        crc.update(data);
+        return (int) crc.getValue();
+    }
+
+    private int getCompressionLevel() {
+        io.papermc.paper.configuration.GlobalConfiguration config = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return config == null
+            ? io.papermc.paper.configuration.GlobalConfiguration.UnsupportedSettings.LinearPreset.NORMAL.compressionLevel
+            : config.unsupportedSettings.effectiveLinearCompressionLevel();
+    }
+
+    private int getCompressionThreads() {
+        io.papermc.paper.configuration.GlobalConfiguration config = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return config == null
+            ? io.papermc.paper.configuration.GlobalConfiguration.UnsupportedSettings.LinearPreset.NORMAL.compressionThreads
+            : config.unsupportedSettings.effectiveLinearCompressionThreads();
+    }
+
+    private int getCompactionThresholdMb() {
+        io.papermc.paper.configuration.GlobalConfiguration config = io.papermc.paper.configuration.GlobalConfiguration.get();
+        return config == null
+            ? io.papermc.paper.configuration.GlobalConfiguration.UnsupportedSettings.LinearPreset.NORMAL.compactionThresholdMb
+            : config.unsupportedSettings.effectiveLinearCompactionThresholdMb();
+    }
+
+    private static boolean readFully(FileChannel channel, ByteBuffer buffer, long position) throws IOException {
+        int offset = 0;
+        while (buffer.hasRemaining()) {
+            int read = channel.read(buffer, position + offset);
+            if (read < 0) {
+                return false;
+            }
+            if (read == 0) {
+                Thread.onSpinWait();
+            } else {
+                offset += read;
+            }
+        }
+        return true;
+    }
+
+    private static void writeFully(FileChannel channel, ByteBuffer buffer, long position) throws IOException {
+        int offset = 0;
+        while (buffer.hasRemaining()) {
+            int written = channel.write(buffer, position + offset);
+            if (written == 0) {
+                Thread.onSpinWait();
+            } else {
+                offset += written;
+            }
+        }
+    }
+
+    private static void atomicReplace(Path source, Path target) throws IOException {
+        try {
+            Files.move(source, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+        } catch (AtomicMoveNotSupportedException ignored) {
+            Files.move(source, target, StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+
+    private static Path backupPath(Path original, String reason) {
+        return original.resolveSibling(original.getFileName() + "." + reason + "." + Util.getEpochMillis() + ".bak");
+    }
+
+    private void ensureOpen() throws IOException {
+        if (this.closed) {
+            throw new IOException("Linear region file is closed: " + this.path);
+        }
+    }
+
+    private void ensureWritable() throws IOException {
+        this.ensureOpen();
+        if (this.closing) {
+            throw new IOException("Linear region file is closing: " + this.path);
+        }
+    }
+
+    private class ChunkBuffer extends ByteArrayOutputStream {
+        private final ChunkPos pos;
+
+        ChunkBuffer(ChunkPos pos) {
+            super(8192);
+            this.pos = pos;
+        }
+
+        @Override
+        public void close() throws IOException {
+            synchronized (LinearRegionFile.this) {
+                LinearRegionFile.this.ensureWritable();
+                LinearRegionFile.this.queueWrite(getIndex(this.pos), this.toByteArray(), getTimestamp());
+            }
+        }
+    }
+
+    static record FlushBatch(List<PendingWrite> writes, long generation) {}
+
+    static record PendingWrite(int index, @Nullable byte[] data, int timestamp, long generation) {}
+
+    private record Entry(long payloadOffset, int rawLength, int compressedLength, int timestamp, long generation, int checksum, boolean tombstone, long recordLength) {}
+
+    private record WrittenEntry(PendingWrite pending, Entry entry) {}
+
+    private record EncodedWrite(PendingWrite pending, byte[] compressed, int checksum) {}
+
+    private static final class LimitedInputStream extends FilterInputStream {
+        private long remaining;
+
+        private LimitedInputStream(InputStream input, long remaining) {
+            super(input);
+            this.remaining = remaining;
+        }
+
+        @Override
+        public int read() throws IOException {
+            if (this.remaining == 0L) {
+                return -1;
+            }
+            int value = super.read();
+            if (value >= 0) {
+                this.remaining--;
+            }
+            return value;
+        }
+
+        @Override
+        public int read(byte[] data, int offset, int length) throws IOException {
+            if (this.remaining == 0L) {
+                return -1;
+            }
+            int read = super.read(data, offset, (int) Math.min(length, this.remaining));
+            if (read > 0) {
+                this.remaining -= read;
+            }
+            return read;
+        }
+    }
+}
