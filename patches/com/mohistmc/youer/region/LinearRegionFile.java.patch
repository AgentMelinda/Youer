+    synchronized FlushBatch createFlushBatch() {
+        if (this.persistedGeneration >= this.currentGeneration) {
+            return null;
+        }
+        List<PendingWrite> writes = new ArrayList<>();
+        long maxGeneration = this.persistedGeneration;
+        for (PendingWrite pending : this.pendingWrites) {
+            if (pending != null) {
+                writes.add(pending);
+                maxGeneration = Math.max(maxGeneration, pending.generation());
+            }
+        }
+        return writes.isEmpty() ? null : new FlushBatch(List.copyOf(writes), maxGeneration);
+    }
