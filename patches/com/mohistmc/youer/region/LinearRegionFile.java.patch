+    private void prepareExistingFile() throws IOException {
+        if (!Files.isRegularFile(this.path) || Files.size(this.path) == 0L) {
+            return;
+        }
+        ByteBuffer prefix = ByteBuffer.allocate(Long.BYTES + 1);
+        try (FileChannel channel = FileChannel.open(this.path, StandardOpenOption.READ)) {
+            if (!readFully(channel, prefix, 0L)) {
+                throw new IOException("Linear region header is truncated: " + this.path);
+            }
+        }
+        prefix.flip();
+        long signature = prefix.getLong();
+        int version = Byte.toUnsignedInt(prefix.get());
+        if (signature != SIGNATURE) {
+            throw new IOException("Linear region has invalid signature: " + this.path);
+        }
+        if (version == VERSION_1) {
+            this.migrateV1ToV2();
+        } else if (version != VERSION_2) {
+            throw new IOException("Unsupported Linear region version " + version + ": " + this.path);
+        }
+    }
