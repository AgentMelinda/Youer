+    private void migrateV1ToV2() throws IOException {
+        Path tmp = Files.createTempFile(this.folder, "linear-v2-", ".tmp");
+        try (DataInputStream input = new DataInputStream(Files.newInputStream(this.path));
+             FileChannel output = FileChannel.open(tmp, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING)) {
+            long signature = input.readLong();
+            int version = input.readUnsignedByte();
+            if (signature != SIGNATURE || version != VERSION_1) {
+                throw new IOException("Invalid Linear v1 header: " + this.path);
+            }
+            input.readLong();
+            input.readUnsignedByte();
+            input.readUnsignedShort();
+            int bodyLength = input.readInt();
+            input.skipNBytes(8L);
+            if (bodyLength < 0) {
+                throw new IOException("Invalid Linear v1 body length " + bodyLength + ": " + this.path);
+            }
+
+            writeFileHeader(output);
+            int[] sizes = new int[ENTRY_COUNT];
+            int[] timestamps = new int[ENTRY_COUNT];
+            long position = FILE_HEADER_LENGTH;
+            long generation = 0L;
+            try (DataInputStream body = new DataInputStream(new ZstdInputStream(new LimitedInputStream(input, bodyLength)))) {
+                for (int slot = 0; slot < ENTRY_COUNT; slot++) {
+                    sizes[slot] = body.readInt();
+                    timestamps[slot] = body.readInt();
+                    if (sizes[slot] < 0 || sizes[slot] > MAX_CHUNK_BYTES) {
+                        throw new IOException("Invalid Linear v1 chunk length " + sizes[slot] + " at slot " + slot);
+                    }
+                }
+                for (int slot = 0; slot < ENTRY_COUNT; slot++) {
+                    if (sizes[slot] == 0) {
+                        continue;
+                    }
+                    byte[] raw = body.readNBytes(sizes[slot]);
+                    if (raw.length != sizes[slot]) {
+                        throw new IOException("Truncated Linear v1 chunk at slot " + slot + ": " + this.path);
+                    }
+                    byte[] compressed = compress(raw, this.getCompressionLevel(), this.getCompressionThreads());
+                    Entry entry = appendRecord(output, position, slot, 0, timestamps[slot], ++generation, raw.length, compressed, checksum(raw));
+                    position += entry.recordLength();
+                }
+            }
+            output.force(true);
+        } catch (Throwable throwable) {
+            Files.deleteIfExists(tmp);
+            throw throwable;
+        }
+
+        Path backup = backupPath(this.path, "v1");
+        Files.move(this.path, backup, StandardCopyOption.REPLACE_EXISTING);
+        try {
+            atomicReplace(tmp, this.path);
+        } catch (IOException ioexception) {
+            Files.move(backup, this.path, StandardCopyOption.REPLACE_EXISTING);
+            throw ioexception;
+        }
+        LOGGER.info("Migrated Linear v1 region {} to incremental v2; original archived as {}", this.path.getFileName(), backup.getFileName());
+    }
